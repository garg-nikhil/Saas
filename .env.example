# GEMINI_API_KEY: Required for Gemini AI API calls (injected at runtime).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (injected at runtime).
APP_URL="MY_APP_URL"

# ==============================================================================
# SaaS Factory - Milestone Environment Variables (Placeholders only)
# ==============================================================================
# Database & Backend Storage (PostgreSQL / Supabase / Hyperdrive)
DATABASE_URL="postgresql://user:password@host:5432/dbname"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
# Cloudflare Hyperdrive configuration ID (referenced in wrangler.jsonc)
CLOUDFLARE_HYPERDRIVE_ID="your-hyperdrive-id"

# Billing & Payments (Milestone 4A - Stripe adapter)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Transactional Email (Milestone 4A - Resend adapter)
RESEND_API_KEY="re_placeholder"
EMAIL_FROM="SaaS Factory <notifications@example.com>"

# Analytics (Milestone 4B - PostHog adapter)
# Server-side API key or project token (server-only)
POSTHOG_KEY="phc_placeholder"
POSTHOG_HOST="https://us.i.posthog.com"

# Observability & Error Monitoring (Milestone 4B - Sentry adapter)
# Server-side Sentry DSN (server-only)
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Storage (Milestone 4B - Supabase Storage adapter)
STORAGE_BUCKET_DEFAULT="user-assets"

